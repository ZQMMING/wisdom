{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisdom.shuntian/schema/rule.schema.json",
  "title": "RuleRecord",
  "description": "V2.2.2 FINAL §45-48 Rule Registry 记录。Rule 必须可追溯至 Source；禁止嵌套、禁止比较符、禁止评分。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id", "engine", "source_ids", "scope", "preconditions",
    "operator", "output", "version", "status"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^(CAND-)?[A-Z]{4}-[0-9]{3}$",
      "description": "候选前缀 CAND- 在 Human 审批后去除"
    },
    "engine": {
      "type": "string",
      "enum": [
        "YUHAI_ZIPING", "ZIPIN_ZHENQUAN", "DI_TIAN_SUI",
        "QIONGTONG_BAOJIAN", "SANMING_TONGHUI", "SHENFENG_TONGKAO"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z]{4}-[0-9]{3}-[0-9]{3}$" },
      "description": "Rule 证据链：每一条 Rule 必须绑定至少一个 Source（V2.22 §63 Phase 4）"
    },
    "rule_type": {
      "type": "string",
      "enum": ["definition", "resolution", "activation", "effectiveness", "diagnosis", "medicine"]
    },
    "scope": {
      "type": "string",
      "enum": ["natal", "decade", "year", "month", "day", "hour", "shensha", "palace"],
      "description": "时间层：natal/dayun/liunian/liuyue/liuri/liushi 的表示；shensha/palace 为领域作用域"
    },
    "subject": { "type": "string", "minLength": 1 },
    "predicate": { "type": "string", "minLength": 1 },
    "preconditions": {
      "$ref": "#/$defs/preconditions"
    },
    "operator": {
      "type": "string",
      "enum": ["emit", "require", "suppress"],
      "description": "Rule 顶层动作（V2.22 §45 operator；知识工程候选数据 operation 字段映射至此）"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "boolean"] }
      }
    },
    "evidence_requirement": {
      "type": "string",
      "enum": ["A", "B", "C", "D"],
      "description": "证据等级要求（V2.22 §78），Phase 5 落 Evidence Registry"
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": {
      "type": "string",
      "enum": ["CANDIDATE", "APPROVED", "REJECTED", "NEEDS_REVIEW", "FROZEN"]
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "conditions"],
      "properties": {
        "type": { "type": "string", "enum": ["conjunction", "disjunction"] },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" },
          "description": "保持一层结构，禁止嵌套 conditions"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "operator": {
          "type": "string",
          "enum": ["equals", "in", "not_in", "exists", "not_exists"],
          "description": "V2.22 §46 白名单；候选数据 has→exists、absent→not_exists 映射"
        },
        "value": { "type": ["string", "number", "boolean", "array", "null"] }
      }
    }
  }
}
