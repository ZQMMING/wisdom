{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tongshu.local/schemas/rule.schema.json",
  "title": "TONGSHU Rule v1.4",
  "description": "Schema for individual Rule records in the Rule DB. v1.4: added scenario field for 刑冲场景化 (DISPATCH_HERMES_IMG_YAO_IMPLEMENTATION).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "title",
    "rule_type",
    "source",
    "conditions",
    "conclusion",
    "applies_to_layers",
    "produces_signal_type",
    "forbidden_inferences",
    "evidence_refs",
    "status",
    "spec_decisions_ref",
    "version"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9]{3,5}$",
      "description": "Stable unique identifier."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "格局判定", "用神取用", "调候", "通关", "体用辨析", "月令司权",
        "旺衰判定", "生克制化", "流通判断", "大运起止", "流年触发",
        "流月细化", "流日激活", "十神定性", "六亲映射", "神煞判定",
        "纳音归属", "婚姻断事", "健康断事"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work", "chapter", "location"],
      "properties": {
        "work": {
          "type": "string",
          "enum": [
            "子平真诠", "滴天髓", "穷通宝鉴", "三命通会", "渊海子平",
            "紫微斗数", "河洛真数", "工程种子", "五行精纪", "李虚中命书"
          ]
        },
        "edition": {"type": "string"},
        "chapter": {"type": "string"},
        "location": {"type": "string"},
        "translator": {"type": "string"}
      }
    },
    "conditions": {"$ref": "#/$defs/condition"},
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rationale_classical"],
      "properties": {
        "produces_layer_output_template": {
          "type": "object",
          "description": "DEPRECATED P2: 旧方向机制, 已被produces_semantic_atoms替代. 过渡期保留兼容.",
          "additionalProperties": false,
          "properties": {
            "direction": {
              "type": "string",
              "enum": ["INCREASE", "STABLE", "DECREASE", "DECLINE", "VOLATILE"]
            },
            "polarity": {
              "type": "string",
              "enum": ["active", "neutral", "restricted", "caution", "passive", "opportunity"]
            },
            "strength_modifier": {
              "type": ["string", "null"],
              "enum": ["amplify", "dampen", "neutralize", null]
            },
            "health_organ": {"type": "string"}
          }
        },
        "produces_semantic_atoms": {
          "type": "array",
          "description": "P2: 规则产生的语义原子列表, 对应Modern Concept Registry的concept_id.",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "rationale_classical": {"type": "string", "minLength": 1}
      }
    },
    "applies_to_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["BASELINE", "CYCLE_CONTEXT", "DAILY_ACTIVATION", "EVENT_TOPIC"]
      }
    },
    "produces_signal_type": {
      "type": "string",
      "enum": [
        "ACTION", "OUTPUT", "CONSTRAINT", "RESOURCE",
        "SUPPORT", "RELATION", "REFLECTION", "CHANGE",
        "MARRIAGE_RISK", "HEALTH_RISK", "MARRIAGE_OPPORTUNITY"
      ]
    },
    "forbidden_inferences": {
      "type": "array",
      "items": {"type": "string", "pattern": "^FI-[A-Z0-9-]+$"}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^E-[A-Z0-9-]+$"}
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "validated", "active", "deprecated"]
    },
    "spec_decisions_ref": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^DECISION-[0-9]+(\\.A|\\.B)?$|^SD-[0-9]+$|^DB-[0-9]+$"}
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "precedence": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "specificity_hint": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "author": {"type": "string"},
    "book_id": {"type": "string"},
    "passage_id": {"type": "string"},
    "concept_id": {"type": "string"},
    "principle_id": {"type": "string"},
    "reviewer": {"type": "string"},
    "scope": {"type": "string"},
    "scenario": {
      "type": "string",
      "enum": ["MARRIAGE_HEALTH", "SELF_AWAKENING_TALENT"],
      "description": "v1.4: 刑冲场景化标签"
    }
  },
  "$defs": {
    "leaf_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "op"],
      "properties": {
        "field": {"type": "string"},
        "op": {
          "type": "string",
          "enum": ["eq", "ne", "in", "nin", "contains", "not_contains", "exists", "gte", "lte", "gt", "lt", "regex", "has", "has_any", "has_all", "present", "absent"]
        },
        "value": {}
      }
    },
    "condition": {
      "anyOf": [
        {"$ref": "#/$defs/leaf_condition"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}},
            "any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}},
            "not": {"$ref": "#/$defs/condition"}
          }
        }
      ]
    }
  }
}
