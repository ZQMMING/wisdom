{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/canonical_content.schema.json",
  "title": "Canonical Content Schema v1.0.0",
  "description": "Legacy canonical content schema (pre-v3.6). Superset of this schema includes meta field.",
  "type": "object",
  "required": ["schema_version", "canonical_id", "analysis_context", "theme", "cross_analysis", "signals", "atomic_claims", "exclusions"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "canonical_id": {
      "type": "string"
    },
    "analysis_context": {
      "type": "object"
    },
    "theme": {
      "type": "string"
    },
    "cross_analysis": {
      "oneOf": [
        {"type": "object"},
        {"type": "null"}
      ]
    },
    "signals": {
      "type": "object"
    },
    "atomic_claims": {
      "type": "array",
      "items": {"type": "object"}
    },
    "exclusions": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
