{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TONGSHU Mapping v1.0",
  "description": "Schema for mapping entries (modern semantic tags).",
  "type": "object",
  "required": ["mapping_id", "rule_refs"],
  "properties": {
    "mapping_id": { "type": "string" },
    "rule_refs": { "type": "array", "items": { "type": "string" } },
    "modern_theme": { "type": "string" }
  }
}
