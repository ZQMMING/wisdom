{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/v36/01_CANONICAL_SCHEMA.json",
  "title": "Canonical Content Schema v3.6",
  "description": "Canonical Content SIR (Semantic Intermediate Representation) schema v3.6",
  "type": "object",
  "required": ["schema_version", "canonical_id", "analysis_context", "theme", "cross_analysis", "signals", "atomic_claims", "exclusions"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^CC-[A-Z0-9-]+$"
    },
    "analysis_context": {
      "type": "object",
      "required": ["date", "calendar_system"],
      "properties": {
        "date": {"type": "string"},
        "calendar_system": {"type": "string", "const": "solar"},
        "bazi_version": {"type": "string"},
        "ziwei_version": {"type": "string"},
        "rule_set_version": {"type": "string"},
        "engine_version": {"type": "string"}
      }
    },
    "theme": {
      "type": "string"
    },
    "cross_analysis": {
      "oneOf": [
        {"type": "object"},
        {"type": "null"}
      ]
    },
    "signals": {
      "type": "object"
    },
    "atomic_claims": {
      "type": "array",
      "items": {"type": "object"}
    },
    "exclusions": {
      "type": "array",
      "items": {"type": "object"}
    },
    "meta": {
      "type": "object",
      "description": "V3.6 meta version family + observability trio. All 11 fields must be present together.",
      "required": [
        "request_id", "trace_id", "document_id",
        "schema_version", "calculation_version", "knowledge_version",
        "mapping_version", "translation_version", "audit_version",
        "model_version", "created_at"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^RR-[A-Z0-9-]+$"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^TRACE-[A-Z0-9-]+$"
        },
        "document_id": {
          "type": "string",
          "pattern": "^CC-[A-Z0-9-]+$"
        },
        "schema_version": {"type": "string", "const": "3.6.0"},
        "calculation_version": {"type": "string", "const": "1.0.0"},
        "knowledge_version": {"type": "string", "const": "1.0.0"},
        "mapping_version": {"type": "string", "const": "0.1.0"},
        "translation_version": {"type": "string", "const": "0.1.0"},
        "audit_version": {"type": "string", "const": "1.0.0"},
        "model_version": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
