# SenseNova / MWX API key for AI rating scripts (scripts/a36_ai_rating*.py)
SENSENOVA_API_KEY=

# TONGSHU LLM renderer config
TONGSHU_LLM_API_KEY=
TONGSHU_LLM_BASE_URL=
TONGSHU_LLM_MODEL=

# B-09 Auth (STAGE-A + STAGE-B)
# TONGSHU_AUTH_SECRET: required fail-fast at startup of create_app() (NOT at
# module import time -- R2 rework). Production MUST be a >=32-byte random
# secret sourced from a secret manager. Local dev defaults: a fixed test value
# is injected by tests/conftest.py when running pytest.
TONGSHU_AUTH_SECRET=
# TONGSHU_AUTH_ENFORCED: B-09 STAGE-B feature flag. Default false (permissive:
# parses + tags X-Auth-Would-Deny but never rejects). Flip to true via Hermes
# after a clean 24h observation window per B09_AUTH_PROPOSAL section Q9.
# Allowed truthy: 1 | true | yes | on.
TONGSHU_AUTH_ENFORCED=false

# TONGSHU_TONG_EAGER: when set to 1, builds the FastAPI app at module
# import time (legacy uvicorn entry `tongshu.api.app:app`). Default is the
# factory pattern (uvicorn tongshu.api.app:create_app --factory), which keeps
# import-time side-effect-free so the lazy fail-fast gate can be exercised
# by test fixtures without booting the app.
TONGSHU_TONG_EAGER=
