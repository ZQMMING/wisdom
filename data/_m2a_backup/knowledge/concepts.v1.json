{
  "kind": "concept",
  "items": [
    {
      "concept_id": "旺衰",
      "concept_name": "旺衰",
      "category": "旺衰判定",
      "aliases": ["日主旺衰", "强旺衰"],
      "definition": "日主五行之力量强弱,判据=得令(月令主气生扶)/得地(通根)/得势(得党)。",
      "source_refs": ["ZIPING-ZHENQUAN", "DITIANSUI", "SANMING-TONGHUI", "YUANHAI-ZIPING"],
      "status": "validated"
    },
    {
      "concept_id": "调候",
      "concept_name": "调候",
      "category": "调候",
      "aliases": ["寒暖燥湿"],
      "definition": "以出生月份之气候(寒暖燥湿)为纲取用神,使日主调候得宜;穷通宝鉴为十日干十二月调候专书。",
      "source_refs": ["QIONGTONG-BAOJIAN"],
      "status": "validated"
    },
    {
      "concept_id": "格局",
      "concept_name": "格局",
      "category": "格局判定",
      "aliases": ["月令格局", "取格"],
      "definition": "以月令为主、日干配月令地支定八格(正官/七杀/正财/偏财/正印/偏印/食神/伤官等),是论命之纲。",
      "source_refs": ["ZIPING-ZHENQUAN", "DITIANSUI"],
      "status": "validated"
    },
    {
      "concept_id": "用神",
      "concept_name": "用神",
      "category": "用神取用",
      "aliases": ["取用", "用神定格"],
      "definition": "命局中用以扶抑日主、成全格局之神;专求月令,随生克不同而格局分焉。",
      "source_refs": ["ZIPING-ZHENQUAN", "DITIANSUI"],
      "status": "validated"
    },
    {
      "concept_id": "喜忌",
      "concept_name": "喜忌",
      "category": "用神取用",
      "aliases": ["喜神", "忌神"],
      "definition": "对日主/格局有利之神为喜,不利者为忌;喜忌决定大运流年之吉凶向背。",
      "source_refs": ["ZIPING-ZHENQUAN", "YUANHAI-ZIPING"],
      "status": "validated"
    },
    {
      "concept_id": "十神",
      "concept_name": "十神",
      "category": "十神定性",
      "aliases": ["六神"],
      "definition": "以日干为太极,对四柱天干/藏干作十类定性:正官/七杀/正印/偏印/比肩/劫财/食神/伤官/正财/偏财。",
      "source_refs": ["ZIPING-ZHENQUAN", "DITIANSUI", "YUANHAI-ZIPING"],
      "status": "validated"
    },
    {
      "concept_id": "生克",
      "concept_name": "生克",
      "category": "生克制化",
      "aliases": ["生助", "克泄"],
      "definition": "五行相生相克之基本作用:生(水生木…)、克(金克木…),是十神关系与格局成败的基础。",
      "source_refs": ["DITIANSUI", "YUANHAI-ZIPING"],
      "status": "validated"
    },
    {
      "concept_id": "制化",
      "concept_name": "制化",
      "category": "生克制化",
      "aliases": ["制", "化"],
      "definition": "制=以克神制太过之神;化=以泄神化太过之神;制化是转凶为吉、调节局势的手段。",
      "source_refs": ["DITIANSUI", "ZIPING-ZHENQUAN"],
      "status": "validated"
    },
    {
      "concept_id": "通关",
      "concept_name": "通关",
      "category": "生克制化",
      "aliases": ["通关用神"],
      "definition": "两行相克,以中间之行为枢纽转克为生,使全局流通(如金木相战以水通关)。",
      "source_refs": ["ZIPING-ZHENQUAN", "DITIANSUI"],
      "status": "validated"
    },
    {
      "concept_id": "十二长生",
      "concept_name": "十二长生",
      "category": "旺衰判定",
      "aliases": ["生旺死绝", "长生十二宫"],
      "definition": "十干于支之十二阶段:长生/沐浴/冠带/临官/帝旺/衰/病/死/墓/绝/胎/养;阳顺阴逆布,定日主于月支之旺衰位。",
      "source_refs": ["SANMING-TONGHUI"],
      "status": "validated"
    },
    {
      "concept_id": "通根",
      "concept_name": "通根",
      "category": "旺衰判定",
      "aliases": ["得地", "有根"],
      "definition": "日主或十神于地支藏干得同气之根(主气比劫/同五行),为得地、根基之判据。",
      "source_refs": ["DITIANSUI"],
      "status": "validated"
    },
    {
      "concept_id": "透干",
      "concept_name": "透干",
      "category": "格局判定",
      "aliases": ["透出"],
      "definition": "地支藏干之十神于四柱天干透出,则其力量显性;月令用神透干则格局成。",
      "source_refs": ["ZIPING-ZHENQUAN", "YUANHAI-ZIPING"],
      "status": "validated"
    },
    {
      "concept_id": "杂气",
      "concept_name": "杂气",
      "category": "格局判定",
      "aliases": ["四库", "杂气格"],
      "definition": "辰戌丑未四墓库支多藏干,取用须辨主气/透干与否,杂气格由此成立。",
      "source_refs": ["ZIPING-ZHENQUAN"],
      "status": "validated"
    },
    {
      "concept_id": "建禄",
      "concept_name": "建禄",
      "category": "格局判定",
      "aliases": ["禄格"],
      "definition": "月支为日主之禄位(甲禄在寅等),月令建禄为建禄格,取用须透干/用财官。",
      "source_refs": ["SANMING-TONGHUI", "YUANHAI-ZIPING"],
      "status": "validated"
    },
    {
      "concept_id": "阳刃",
      "concept_name": "阳刃",
      "category": "格局判定",
      "aliases": ["羊刃", "帝旺"],
      "definition": "日主帝旺之支(甲刃在卯等);月支临阳刃为阳刃格,其性刚烈,取用须制伏。",
      "source_refs": ["YUANHAI-ZIPING"],
      "status": "validated"
    },
    {
      "concept_id": "天乙贵人",
      "concept_name": "天乙贵人",
      "category": "神煞判定",
      "aliases": ["贵人", "天乙"],
      "definition": "以日干查命局地支之吉神(甲戊庚见丑未,乙己见子申,丙丁见亥酉,壬癸见卯巳,辛见午寅);见者主贵人扶助、逢凶化吉。",
      "source_refs": ["SANMING-TONGHUI"],
      "status": "validated"
    }
  ]
}
