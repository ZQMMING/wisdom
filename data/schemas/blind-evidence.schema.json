{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tongshu.local/schemas/blind-evidence.schema.json",
  "title": "Blind Segment Evidence v2.0",
  "description": "Schema for blind segment Evidence records. Separates source_excerpt (verbatim quote) from normalized_summary (modern interpretation). v2.0: 分离原文摘录与整理摘要，明确VERIFIED标准。",

  "type": "object",
  "additionalProperties": true,
  "required": [
    "evidence_id",
    "system",
    "provenance_layer",
    "extraction_topic"
  ],

  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^E-BLIND-[A-Z0-9_-]+$",
      "description": "Stable unique identifier. Format: E-BLIND-<TOPIC>-<NNN>."
    },
    "system": {
      "type": "string",
      "const": "BLIND_SEGMENT",
      "description": "System identifier."
    },
    "provenance_layer": {
      "type": "string",
      "enum": ["A", "B", "C", "D"],
      "description": "Provenance layer: A=传承原文, B=段氏系统化, C=命例, D=后人整理"
    },
    "authority_status": {
      "type": "string",
      "enum": ["UNVERIFIED", "SEMANTIC_MATCHED", "CASE_EVIDENCE", "PENDING_REVIEW", "REJECTED"],
      "description": "Production authority status. SEMANTIC_MATCHED = source verified but not production-admitted."
    },
    "source": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["CANDIDATE", "VERIFIED"] }
      }
    },
    "source_excerpt": {
      "type": "string",
      "description": "Verbatim quote from the source text. EMPTY until source verification completes. This is the PRIMARY provenance field."
    },
    "normalized_summary": {
      "type": "string",
      "description": "Modern interpretation/summary of the source concept. This is the current 'original_text' content - organized for downstream use but NOT the verbatim source."
    },
    "context": {
      "type": "string",
      "description": "Broader context of the evidence"
    },
    "conditions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Triggering conditions"
    },
    "extraction_topic": {
      "type": "string",
      "description": "Topic extracted from source (e.g., BODY_USE_RELATION, WORK_METHOD)"
    },
    "claim_type": {
      "type": "string",
      "enum": ["STRUCTURAL", "MECHANISM", "RESULT", "SPECIAL_ROLE"],
      "description": "Blind segment theory layer"
    },
    "source_fidelity": {
      "type": "string",
      "enum": ["PENDING_VERIFICATION", "SEMANTIC_MATCH", "VERIFIED", "REJECTED"],
      "description": "Source-text match quality: SEMANTIC_MATCH = conceptual alignment, VERIFIED = verbatim match"
    },
    "certainty": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"],
      "description": "Confidence level"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "theory_layer": {
      "type": "string",
      "description": "Theory layer classification (理法-结构, etc.)"
    },
    "source_verification": {
      "type": "object",
      "description": "Detailed verification record",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PENDING", "VERIFIED", "REJECTED"]
        },
        "reason": {
          "type": "string",
          "enum": ["SOURCE_MATCHED", "SEMANTIC_MATCH_ONLY", "SOURCE_UNVERIFIABLE", "SUMMARY_ONLY"]
        },
        "detail": { "type": "string" },
        "edition": { "type": "string" },
        "chapter": { "type": "string" },
        "section": { "type": "string" },
        "locator": { "type": "string" },
        "source_url": { "type": "string" },
        "source_pdf": { "type": "string" },
        "verified_text": { "type": "string", "description": "The actual verbatim text found in source" },
        "comparison_result": {
          "type": "string",
          "enum": ["VERBATIM_MATCH", "SEMANTIC_MATCH", "NO_MATCH"]
        },
        "verification_notes": { "type": "string" },
        "verified_date": { "type": "string", "format": "date-time" },
        "verifier": { "type": "string" },
        "verification_method": {
          "type": "string",
          "enum": ["verbatim_comparison", "semantic_comparison"]
        },
        "confidence": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "properties": {
          "source_fidelity": { "const": "VERIFIED" }
        }
      },
      "then": {
        "required": ["source_excerpt"],
        "properties": {
          "source_excerpt": {
            "minLength": 1,
            "description": "VERIFIED requires a non-empty verbatim source excerpt"
          }
        }
      }
    }
  ]
}
